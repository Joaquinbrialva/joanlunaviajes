# --- Requeridas: sin alguna de estas el servidor no arranca ---

JWT_SECRET=cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres

# Pooler de Supabase en modo transacción (puerto 6543), el indicado para
# serverless. OJO con el usuario: el pooler exige `postgres.<project-ref>`, no
# `postgres` a secas — con el usuario corto falla con "P1000 Authentication
# failed against database server".
# Copiala del dashboard: Connect → Transaction pooler.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- Opcionales: el server arranca sin ellas, pero avisa ---

JWT_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development

# Origen del frontend: define el CORS y la base de los enlaces de los emails
# (verificación de cuenta, reseteo de contraseña).
FRONTEND_URL=https://tu-frontend.vercel.app

# Certificado raíz de Supabase en PEM (Database Settings → SSL Configuration).
# Sin él la conexión va cifrada pero no se verifica la identidad del servidor.
DATABASE_CA_CERT=

# Sin MAIL_USER/MAIL_APP_PASSWORD no se envía ningún email: ni verificación de
# registro, ni reseteo de contraseña, ni avisos de cotización.
MAIL_USER=tu@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_TO=destino@agencia.com

WHATSAPP_NUMBER=5491112345678
